// Jika di Homepage (featuredOnly = true), tampilkan HANYA 1 proyek (Abdurachman Saleh Hub)
const displayProjects = featuredOnly ? [projectsList[0]] : projectsList;
---

<section class="projects" id="proyek">
  <div class="container">
    <div class="section-head reveal" style={featuredOnly ? "text-align: center; max-width: 680px; margin: 0 auto 44px;" : ""}>
      <span class="eyebrow">// CONTOH KARYA KAMI</span>
      <h2 class="section-title">
        {featuredOnly ? "Studi Kasus Proyek Pilihan" : "Katalog Studi Kasus Proyek Nyata"}
      </h2>
      <p class="section-desc" style={featuredOnly ? "margin: 0 auto;" : ""}>
        {featuredOnly 
          ? "Salah satu proyek nyata yang kami bangun dan telah aktif beroperasi melayani ribuan pengguna publik setiap hari."
          : "Jelajahi website bisnis, portal publik, aplikasi mobile, dan otomatisasi hardware yang telah kami selesaikan untuk mempermudah operasional klien."
        }
      </p>
    </div>

    <!-- CONTAINER PROYEK: VERTIKAL (GAMBAR DI ATAS, PENJELASAN DI BAWAH) - LEBIH LEBAR -->
    <div class={featuredOnly ? "featured-project-container" : "projects-catalog-grid"}>
      {displayProjects.map((project) => (
        <article class="project-vertical-card project-interactive-card reveal" data-project-id={project.id}>
          <!-- 1. GAMBAR PREVIEW DI ATAS (PROPORSIONAL, TIDAK TERLALU BESAR) -->
          <div class="project-card-top-visual">
            {project.image ? (
              <div class="browser-mockup-compact">
                <div class="browser-header">
                  <div class="browser-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                  </div>
                  <div class="browser-address-bar">
                    <svg class="icon address-lock-icon"><use href="#icon-shield-check"/></svg>
                    <span class="browser-url-text">{project.url ? project.url.replace('https://', '').replace(/\/$/, '') : 'system.zerobug.team'}</span>
                  </div>
                </div>
                <div class="browser-body-compact">
                  <img src={project.image} alt={`Tampilan Website ${project.title}`} class="project-preview-img-compact" loading="lazy" />
                  <div class="browser-overlay">
                    <span class="overlay-badge">Klik untuk Detail</span>
                  </div>
                </div>
              </div>
            ) : (
              <div class="mockup-terminal-compact">
                <div class="mockup-terminal-bar">
                  <div class="browser-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                  </div>
                  <span class="mockup-terminal-title">{project.title}</span>
                  <span class="mockup-terminal-indicator"></span>
                </div>
                <pre class="mockup-terminal-code"><code><span class="code-comment">// Sistem Produksi Aktif</span>
<span class="code-keyword">PROYEK</span> : "{project.title}"
<span class="code-success">[STATUS] Beroperasi Normal</span>
<span class="code-highlight">[STACK] {project.tags.slice(0, 3).join(' • ')}</span>
[INFO] Klik kartu untuk melihat studi kasus</code></pre>
              </div>
            )}
          </div>

          <!-- 2. PENJELASAN SINGKAT DI BAWAH -->
          <div class="project-card-bottom-info">
            <div class="project-meta-ref">
              <span class="project-sys-id">{project.category}</span>
            </div>

            <h3 class="project-title-compact">{project.title}</h3>
            <p class="project-summary-compact">{project.summary}</p>

            <div class="project-tags project-tags-compact">
              {project.tags.slice(0, 3).map((t) => (
                <span class="tag-pill">{t}</span>
              ))}
            </div>

            <!-- TOMBOL AKSI CEPAT PADA CARD (COMPACT & TANPA IKON) -->
            <div class="project-card-actions">
              <button type="button" class="btn btn-primary btn-compact open-detail-btn" data-project-id={project.id}>
                Lihat Detail
              </button>

              {project.url && (
                <a href={project.url} target="_blank" rel="noopener" class="btn btn-secondary btn-compact" onclick="event.stopPropagation();">
                  Kunjungi Website
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- JIKA DI HOMEPAGE: FREE-TEXT SECTION (TANPA CARD BOX) -->
    {featuredOnly && (
      <div class="projects-more-freetext reveal">
        <h3 class="more-freetext-title">Ingin Menjelajahi Karya Lainnya?</h3>
        <p class="more-freetext-desc">
          Lihat ragam solusi website bisnis, sistem dashboard pemantau sensor, dan aplikasi mobile yang telah kami selesaikan dan siap pakai.
        </p>
        <div class="more-freetext-action">
          <a href="/proyek" class="btn btn-primary btn-md">
            <span>Buka Semua Portofolio Proyek</span>
            <svg class="icon"><use href="#icon-arrow-right"/></svg>
          </a>
        </div>
      </div>
    )}
  </div>

  <!-- MODAL DIALOG DETAIL PROYEK -->
  <div id="project-detail-modal" class="project-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-dialog" data-lenis-prevent>
      <button class="modal-close-btn" id="modal-close-btn" aria-label="Tutup jendela detail">
        <svg class="icon"><use href="#icon-x"/></svg>
      </button>

      <div class="modal-body" id="modal-content-area">
        <!-- Konten Detail Diinjeksi oleh JavaScript -->
      </div>
    </div>
  </div>
</section>

<!-- SCRIPT DATA JSON UNTUK MODAL DETAIL -->
<script is:inline define:vars={{ projectsList }}>
  window.__ZEROBUG_PROJECTS__ = projectsList;

  function initProjectModal() {
    var modal = document.getElementById('project-detail-modal');
    var backdrop = document.getElementById('modal-backdrop');
    var closeBtn = document.getElementById('modal-close-btn');
    var contentArea = document.getElementById('modal-content-area');
    var interactiveCards = document.querySelectorAll('.project-interactive-card');
    var openDetailBtns = document.querySelectorAll('.open-detail-btn');

    if (!modal || !contentArea) return;

    function openModal(projectId) {
      var project = window.__ZEROBUG_PROJECTS__.find(function(p) { return p.id === projectId; });
      if (!project) return;

      var urlSection = project.url ? `
        <div class="modal-link-row">
          <span class="modal-link-label">Website Resmi:</span>
          <a href="${project.url}" target="_blank" rel="noopener" class="modal-blue-text-link">${project.url}</a>
        </div>
      ` : '';

      var imageSection = project.image ? `
        <div class="modal-image-preview">
          <img src="${project.image}" alt="${project.title}" class="modal-preview-img" />
        </div>
      ` : '';

      var featuresHtml = project.detail.features.map(function(f) {
        return `<li><svg class="icon bullet-icon"><use href="#icon-check"/></svg><span>${f}</span></li>`;
      }).join('');

      var techHtml = project.detail.techStack.map(function(t) {
        return `<span class="tag-pill">${t}</span>`;
      }).join('');

      var statsHtml = project.stats && project.stats.length ? `
        <div class="modal-stats-grid">
          ${project.stats.map(function(s) {
            return `
              <div class="modal-stat-item">
                <span class="modal-stat-num">${s.num}</span>
                <span class="modal-stat-label">${s.text}</span>
              </div>
            `;
          }).join('')}
        </div>
      ` : '';

      contentArea.innerHTML = `
        <div class="modal-header-meta">
          <span class="project-sys-id">${project.category}</span>
        </div>

        <h2 class="modal-title">${project.title}</h2>
        <p class="modal-headline">${project.headline}</p>

        ${urlSection}

        ${imageSection}

        ${statsHtml}

        <div class="modal-narrative-grid">
          <div class="modal-block">
            <h3 class="block-title">Latar Belakang &amp; Kebutuhan</h3>
            <p class="block-text">${project.detail.problem}</p>
          </div>

          <div class="modal-block">
            <h3 class="block-title">Solusi Pengembangan ZeroBug</h3>
            <p class="block-text">${project.detail.solution}</p>
          </div>
        </div>

        <div class="modal-block">
          <h3 class="block-title">Fitur-Fitur Kunci yang Diterapkan</h3>
          <ul class="modal-features-list">
            ${featuresHtml}
          </ul>
        </div>

        <div class="modal-block">
          <h3 class="block-title">Spesifikasi Teknologi Terverifikasi</h3>
          <div class="project-tags modal-tags">
            ${techHtml}
          </div>
        </div>

        <div class="modal-footer-cta">
          <p class="cta-note">Ingin membangun sistem dengan arsitektur serupa?</p>
          <a href="https://wa.me/6281229523471?text=Halo%20ZeroBug,%20saya%20tertarik%20dengan%20proyek%20${encodeURIComponent(project.title)}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
            <span>Diskusikan Proyek Anda</span>
          </a>
        </div>
      `;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (window.__lenis) window.__lenis.stop();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (window.__lenis) window.__lenis.start();
    }

    // Pasang listener pada card
    interactiveCards.forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('a')) return;
        var pId = card.getAttribute('data-project-id');
        openModal(pId);
      });
    });

    // Pasang listener pada tombol detail
    openDetailBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var pId = btn.getAttribute('data-project-id');
        openModal(pId);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  }

  document.addEventListener('astro:page-load', initProjectModal);
</script>

<style>
  /* Layout Kontainer Proyek - Lebih Lebar & Mewah */
  .featured-project-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .projects-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 32px;
  }

  /* Kartu Vertikal Proposional (Gambar di Atas, Penjelasan di Bawah) */
  .project-vertical-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(36, 122, 155, 0.05);
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .project-vertical-card:hover {
    transform: translateY(-4px);
    border-color: var(--steel-cyan);
    box-shadow: 0 16px 42px rgba(36, 122, 155, 0.12);
  }

  .project-vertical-card:active {
    transform: scale(0.985);
    transition-duration: 0.12s;
  }

  /* 1. BAGIAN ATAS: VISUAL PREVIEW WIDESCREEN PROPORSIONAL */
  .project-card-top-visual {
    width: 100%;
    background: #0B1120;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .browser-mockup-compact {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .browser-header {
    background: #1E293B;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .browser-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot-red { background: #EF4444; }
  .dot-yellow { background: #F59E0B; }
  .dot-green { background: #10B981; }

  .browser-address-bar {
    flex-grow: 1;
    background: #0F172A;
    border-radius: var(--radius-pill);
    padding: 3px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #94A3B8;
  }

  .address-lock-icon {
    width: 12px;
    height: 12px;
    color: #10B981;
  }

  /* Tinggi visual proporsional mengikuti rasio screenshot asli website bandara */
  .browser-body-compact {
    width: 100%;
    aspect-ratio: 2.15 / 1;
    min-height: 260px;
    max-height: 480px;
    position: relative;
    overflow: hidden;
    background: #0B1120;
  }

  .project-preview-img-compact {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform .4s ease;
  }

  .project-vertical-card:hover .project-preview-img-compact {
    transform: scale(1.035);
  }

  .browser-overlay {
    position: absolute;
    inset: 0;
    background: rgba(17, 30, 40, 0.35);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .25s ease;
  }

  .project-vertical-card:hover .browser-overlay {
    opacity: 1;
  }

  .overlay-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    color: var(--steel-cyan);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    border: 1px solid var(--steel-cyan);
    transform: translateY(4px);
    transition: transform .25s ease;
  }

  .project-vertical-card:hover .overlay-badge {
    transform: translateY(0);
  }

  /* Mockup Terminal untuk Proyek Non-Gambar */
  .mockup-terminal-compact {
    padding: 24px;
    background: #142533;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .mockup-terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(86, 197, 232, 0.2);
    padding-bottom: 10px;
  }

  .mockup-terminal-title {
    font-size: 0.74rem;
    color: var(--cyan-light);
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mockup-terminal-code {
    margin: 0;
    line-height: 1.6;
    color: #94A3B8;
  }
  .mockup-terminal-code .code-comment { color: #64748B; }
  .mockup-terminal-code .code-keyword { color: #56C5E8; font-weight: 700; }
  .mockup-terminal-code .code-success { color: #10B981; }
  .mockup-terminal-code .code-highlight { color: #F59E0B; }

  /* 2. BAGIAN BAWAH: PENJELASAN SINGKAT & SPESIFIKASI */
  .project-card-bottom-info {
    padding: 30px 34px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .project-meta-ref {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .project-sys-id {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--steel-cyan);
    text-transform: uppercase;
  }

  .project-status-tag {
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--cyan-tint);
    color: var(--steel-cyan);
    border: 1px solid var(--steel-cyan);
  }

  .project-title-compact {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 6px;
    color: var(--ink);
  }

  .project-headline-sub {
    font-size: 0.86rem;
    font-weight: 600;
