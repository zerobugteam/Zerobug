---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const emailAddress = "zerobug.team@gmail.com";
const waNumber = "+62 812-2952-3471";
const waLink = "https://wa.me/6281229523471";
---

<Layout 
  title="Hubungi ZeroBug | Kontak Email & Konsultasi Proyek" 
  description="Hubungi tim ZeroBug via email di zerobug.team@gmail.com atau WhatsApp untuk konsultasi teknis, estimasi biaya, dan perancangan website, aplikasi, atau IoT."
>
  <Header />

  <main class="contact-page">
    <section class="contact-hero">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 700px; margin: 0 auto 50px;">
          <span class="eyebrow">// HUBUNGI KAMI VIA EMAIL</span>
          <h1 class="section-title">Mari Bicarakan Ide &amp; Kebutuhan Sistem Anda</h1>
          <p class="section-desc" style="margin: 0 auto;">
            Punya rencana membuat website baru, aplikasi mobile, atau otomatisasi IoT? Kirimkan rincian kebutuhan Anda lewat email. Kami siap menganalisis solusi teknis yang tepat dan realistis.
          </p>
        </div>

        <div class="contact-grid reveal">
          <!-- KOLOM KIRI: JAMINAN RESPON & KANAL KONTAK -->
          <div class="contact-info-panel">
            <div class="trust-points-list">
              <div class="trust-item">
                <div class="trust-icon">
                  <svg class="icon"><use href="#icon-mail"/></svg>
                </div>
                <div>
                  <strong class="trust-title">Email Resmi Studio</strong>
                  <p class="trust-desc">Kirim pesan langsung ke <a href={`mailto:${emailAddress}`} style="color:var(--steel-cyan);font-weight:600;text-decoration:underline;">{emailAddress}</a> atau gunakan formulir di samping.</p>
                </div>
              </div>

              <div class="trust-item">
                <div class="trust-icon">
                  <svg class="icon"><use href="#icon-clock"/></svg>
                </div>
                <div>
                  <strong class="trust-title">Respon di Bawah 24 Jam</strong>
                  <p class="trust-desc">Setiap pesan masuk dibaca dan dibalas langsung oleh lead engineer kami pada hari kerja.</p>
                </div>
              </div>

              <div class="trust-item">
                <div class="trust-icon">
                  <svg class="icon"><use href="#icon-check"/></svg>
                </div>
                <div>
                  <strong class="trust-title">Konsultasi Awal 100% Gratis</strong>
                  <p class="trust-desc">Diskusi pemetaan arsitektur awal, estimasi waktu, dan saran teknologi tanpa ada ikatan kontrak apa pun.</p>
                </div>
              </div>

              <div class="trust-item">
                <div class="trust-icon">
                  <svg class="icon"><use href="#icon-shield-check"/></svg>
                </div>
                <div>
                  <strong class="trust-title">Kerahasiaan Ide Terjamin (NDA)</strong>
                  <p class="trust-desc">Kami siap menandatangani perjanjian kerahasiaan (*Non-Disclosure Agreement*) sebelum pembahasan mendalam dimulai.</p>
                </div>
              </div>
            </div>

            <!-- ALTERNATIF WHATSAPP CEPAT -->
            <div class="alt-channel-box">
              <div class="alt-channel-text">
                <strong>Butuh tanggapan cepat hari ini?</strong>
                <p>Anda juga bisa menghubungi kami langsung melalui pesan WhatsApp bisnis.</p>
              </div>
              <a href={waLink} target="_blank" rel="noopener" class="btn btn-secondary btn-sm alt-wa-btn">
                <span>Chat WhatsApp</span>
                <svg class="icon"><use href="#icon-arrow-right"/></svg>
              </a>
            </div>
          </div>

          <!-- KOLOM KANAN: FORM DRAFT EMAIL INTERAKTIF -->
          <div class="contact-form-panel">
            <div class="form-header">
              <h2 class="form-title">Tulis Pesan untuk Tim Engineer</h2>
              <p class="form-subtitle">Isi formulir di bawah ini. Pesan Anda akan langsung terkirim otomatis ke email tim kami tanpa perlu membuka aplikasi email terpisah.</p>
            </div>

            <!-- KOTAK NOTIFIKASI SUKSES (TERKIRIM OTOMATIS) -->
            <div id="form-success-box" class="form-status-box form-success" style="display:none;" role="alert">
              <div class="status-icon-wrap">
                <svg class="status-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="status-content">
                <h3 class="status-title">Pesan Berhasil Terkirim!</h3>
                <p class="status-desc" id="status-success-desc">
                  Terima kasih! Pesan Anda telah otomatis terkirim langsung ke email tim ZeroBug (<span class="highlight-email">zerobug.team@gmail.com</span>). Lead engineer kami akan meninjau dan merespon dalam waktu maksimal 24 jam kerja.
                </p>
                <div class="status-action-row">
                  <button type="button" class="btn btn-secondary btn-sm" id="btn-reset-form">
                    <span>Kirim Pesan Lain</span>
                  </button>
                  <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                    <span>Chat WhatsApp Cepat</span>
                    <svg class="icon"><use href="#icon-arrow-right"/></svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- KOTAK NOTIFIKASI ERROR (JIKA GAGAL JARINGAN) -->
            <div id="form-error-box" class="form-status-box form-error" style="display:none;" role="alert">
              <div class="status-icon-wrap status-error-wrap">
                <svg class="status-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
              </div>
              <div class="status-content">
                <strong class="status-title">Gagal Mengirim Pesan</strong>
                <p class="status-desc" id="status-error-msg">
                  Terjadi kendala jaringan saat mengirim pesan. Jangan khawatir, Anda bisa langsung menghubungi kami via <a href={waLink} target="_blank" rel="noopener">WhatsApp ({waNumber})</a> atau kirim email langsung ke <a href={`mailto:${emailAddress}`}>{emailAddress}</a>.
                </p>
              </div>
            </div>

            <!-- FORMULIR KONTAK UTAMA -->
            <form id="contact-email-form" class="email-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="sender-name">Nama Anda / Perusahaan <span class="required">*</span></label>
                  <input type="text" id="sender-name" name="name" placeholder="Misal: Budi Santoso (PT Solusi Maju)" required />
                </div>
                <div class="form-group">
                  <label for="sender-email">Alamat Email Anda <span class="required">*</span></label>
                  <input type="email" id="sender-email" name="email" placeholder="nama@perusahaan.com" required />
                </div>
              </div>

              <div class="form-group">
                <label for="project-type">Kebutuhan Proyek / Sistem</label>
                <select id="project-type" name="service">
                  <option value="Pembuatan Website Usaha / Toko Online">Website Usaha / Profil Perusahaan / E-Commerce</option>
                  <option value="Aplikasi Mobile Android & iOS">Aplikasi Mobile (Android &amp; iOS)</option>
                  <option value="Integrasi Alat Pintar IoT & Sensor">Alat Pintar IoT, Sensor &amp; Otomasi Pabrik</option>
                  <option value="Audit, Refactor, & Perbaikan Sistem">Audit, Pembersihan Bug, atau Lanjutan Sistem Lama</option>
                  <option value="Konsultasi Teknis & Arsitektur">Konsultasi Teknis &amp; Arsitektur Sistem</option>
                </select>
              </div>

              <div class="form-group">
                <label for="project-timeline">Target Waktu Penyelesaian (Opsional)</label>
                <input type="text" id="project-timeline" name="timeline" placeholder="Misal: 1-2 Bulan kedepan / Secepatnya" />
              </div>

              <div class="form-group">
                <label for="project-message">Rincian Kebutuhan atau Gambaran Ide <span class="required">*</span></label>
                <textarea id="project-message" name="message" rows="5" placeholder="Ceritakan alur bisnis yang ingin dibuat, fitur-fitur penting yang dibutuhkan, atau kendala teknis pada sistem yang sedang dihadapi..." required></textarea>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg submit-btn" id="submit-btn">
                  <span class="btn-spinner" id="btn-spinner" style="display:none;"></span>
                  <svg class="icon submit-icon" id="btn-icon" aria-hidden="true"><use href="#icon-send"/></svg>
                  <span class="submit-text" id="btn-text">Kirim Pesan Langsung</span>
                </button>
              </div>

              <p class="form-footer-note">
                <svg class="icon" style="width:14px; height:14px;"><use href="#icon-shield-check"/></svg>
                <span>Privasi data Anda aman. Pesan langsung dikirim ke email tim ZeroBug tanpa perlu membuka aplikasi email.</span>
              </p>
            </form>
          </div>
        </div>

        <!-- FAQ SINGKAT KONTAK EMAIL -->
        <div class="contact-faq-section reveal">
          <h3 class="faq-section-title">Pertanyaan Umum Sebelum Menghubungi</h3>
          <div class="faq-grid">
            <div class="faq-card">
              <h4 class="faq-q">Apa yang terjadi setelah saya mengirim email?</h4>
              <p class="faq-a">Tim teknis kami akan membaca rincian kebutuhan Anda, menyusun estimasi awal skema sistem, dan membalas email Anda dengan opsi solusi konkret serta jadwal diskusi teknis lanjutan jika diperlukan.</p>
            </div>
            <div class="faq-card">
              <h4 class="faq-q">Apakah ada biaya untuk konsultasi awal?</h4>
              <p class="faq-a">Sama sekali tidak ada biaya. Kami menyambut baik diskusi teknis untuk memahami masalah bisnis Anda terlebih dahulu sebelum membahas penawaran pengerjaan.</p>
            </div>
            <div class="faq-card">
              <h4 class="faq-q">Bagaimana jika proyek saya sudah memiliki kode berjalan?</h4>
              <p class="faq-a">Sangat bisa. Kami berpengalaman melakukan *code audit*, refactoring kode yang berantakan, serta melanjutkan sistem yang ditinggalkan developer sebelumnya agar siap kembali ke produksi.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  function initContactForm() {
    const contactForm = document.getElementById('contact-email-form');
    const successBox = document.getElementById('form-success-box');
    const errorBox = document.getElementById('form-error-box');
    const successDesc = document.getElementById('status-success-desc');
    const resetBtn = document.getElementById('btn-reset-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnIcon = document.getElementById('btn-icon');
    const btnText = document.getElementById('btn-text');

    if (!contactForm) return;

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (successBox) successBox.style.display = 'none';
        if (errorBox) errorBox.style.display = 'none';
        contactForm.style.display = 'flex';
        contactForm.reset();
      });
    }

    contactForm.addEventListener('submit', async function (e) {
      e.preventDefault();

      if (errorBox) errorBox.style.display = 'none';

      const name = document.getElementById('sender-name').value.trim();
      const email = document.getElementById('sender-email').value.trim();
      const type = document.getElementById('project-type').value;
      const timeline = document.getElementById('project-timeline').value.trim();
      const message = document.getElementById('project-message').value.trim();

      if (!name || !email || !message) return;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      if (btnIcon) btnIcon.style.display = 'none';
      if (btnText) btnText.textContent = 'Mengirim Pesan...';

      try {
        const payload = {
          "Nama / Perusahaan": name,
          "Email Pengirim": email,
          "Kebutuhan Proyek": type,
          "Target Waktu": timeline || 'Fleksibel',
          "Rincian Kebutuhan": message,
          "_subject": `[Inisiasi Proyek Baru] ${type} - ${name}`,
          "_template": "table",
          "_captcha": "false"
        };

        const response = await fetch("https://formsubmit.co/ajax/zerobug.team@gmail.com", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          contactForm.style.display = 'none';
          if (successBox) {
            successBox.style.display = 'flex';
            if (successDesc) {
              successDesc.innerHTML = `Terima kasih, <strong>${name}</strong>! Pesan Anda telah otomatis dikirimkan ke email tim ZeroBug (<span class="highlight-email">zerobug.team@gmail.com</span>). Lead engineer kami akan meninjau dan membalas dalam waktu maksimal 24 jam kerja.`;
            }
          }
        } else {
          throw new Error('Gagal mengirim form');
        }
      } catch (err) {
        if (errorBox) errorBox.style.display = 'flex';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnSpinner) btnSpinner.style.display = 'none';
        if (btnIcon) btnIcon.style.display = 'inline-flex';
        if (btnText) btnText.textContent = 'Kirim Pesan Langsung';
      }
    });
  }

  // Aktifkan saat halaman selesai dimuat dan saat navigasi View Transitions
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-page {
    padding-top: 20px;
    padding-bottom: 60px;
  }

  .contact-hero {
    padding: 60px 0 20px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 70px;
  }

  /* Info Panel Kiri */
  .contact-info-panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Trust Points List */
  .trust-points-list {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .trust-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .trust-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--steel-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trust-title {
    display: block;
    font-size: 0.95rem;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .trust-desc {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  /* Alt Channel WhatsApp */
  .alt-channel-box {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .alt-channel-text strong {
    display: block;
    font-size: 0.9rem;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .alt-channel-text p {
    font-size: 0.8rem;
    color: var(--ink-secondary);
  }

  .alt-wa-btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Form Panel Kanan */
  .contact-form-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: 0 4px 24px rgba(36, 122, 155, 0.05);
  }

  .form-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 18px;
    margin-bottom: 26px;
  }

  .form-title {
    font-size: 1.35rem;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .form-subtitle {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .email-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  .required {
    color: #C0392B;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-elevated);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.92rem;
    transition: all .2s ease;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--steel-cyan);
    box-shadow: 0 0 0 3px var(--cyan-glow);
    background: #FFFFFF;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 110px;
  }

  .form-actions {
    margin-top: 8px;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    padding: 14px 24px;
    font-size: 0.98rem;
    gap: 10px;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .submit-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Spinner Tombol */
  .btn-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #FFFFFF;
    border-radius: 50%;
    animation: btnSpin 0.7s linear infinite;
    display: inline-block;
  }

  @keyframes btnSpin {
    to { transform: rotate(360deg); }
  }

  /* Status Box (Sukses & Error) */
  .form-status-box {
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 22px;
    animation: fadeInStatus 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInStatus {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .form-success {
    background: var(--surface-elevated);
    border: 1px solid var(--steel-cyan);
    box-shadow: 0 8px 24px var(--cyan-glow);
  }

  .form-error {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.35);
  }

  .status-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--steel-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .status-error-wrap {
    background: rgba(239, 68, 68, 0.15);
    color: #EF4444;
  }

  .status-svg {
    width: 22px;
    height: 22px;
  }

  .status-content {
    flex: 1;
  }

  .status-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px 0;
  }

  .status-desc {
    font-size: 0.88rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }

  .status-desc strong,
  .status-desc .highlight-email {
    color: var(--steel-cyan);
    font-weight: 600;
  }

  .status-action-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .form-footer-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--ink-muted);
    line-height: 1.4;
    margin-top: 8px;
  }

  /* FAQ Section */
  .contact-faq-section {
    border-top: 1px solid var(--border);
    padding-top: 50px;
  }

  .faq-section-title {
    font-size: 1.25rem;
    color: var(--ink);
    text-align: center;
    margin-bottom: 32px;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .faq-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    box-shadow: 0 2px 12px rgba(36, 122, 155, 0.03);
  }

  .faq-q {
    font-size: 0.98rem;
    color: var(--ink);
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .faq-a {
    font-size: 0.86rem;
    color: var(--ink-secondary);
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .faq-grid { grid-template-columns: 1fr; }
    .alt-channel-box { flex-direction: column; align-items: flex-start; }
    .alt-wa-btn { width: 100%; justify-content: center; }
  }
</style>

