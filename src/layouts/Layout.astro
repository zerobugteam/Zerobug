---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ZeroBug Team | Pembuatan Website, Aplikasi HP, & IoT",
  description = "ZeroBug Team membantu Anda membuat Website, Aplikasi Android & iPhone, serta Alat Pintar IoT siap pakai.",
  image = "/og-image.png"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://zerobug-two.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
---

<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#247A9B" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / WhatsApp / Facebook / LinkedIn / Telegram -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="ZeroBug Team" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:secure_url" content={ogImageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ZeroBug Team | Software Design & Smart Systems" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Favicon & Touch Icon -->
  <link rel="icon" href="/logotrans.png" type="image/png" />
  <link rel="apple-touch-icon" href="/logotrans.png" />

  <!-- Google Fonts: Asynchronous Non-Blocking Load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
  </noscript>

  <!-- Astro View Transitions for Ultra-Smooth Page Transitions -->
  <ClientRouter />

  <script is:inline>
    // Inisialisasi tema instan agar tidak flicker saat load / pindah halaman
    (function () {
      try {
        var saved = localStorage.getItem('zerobug_theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
      document.documentElement.classList.add('js');
    })();
  </script>
</head>
<body>

  <!-- Top Cyan Shimmer Progress Bar -->
  <div id="page-progress-bar" style="position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg, #56C5E8, #247A9B, #86D9F3);box-shadow:0 0 12px #56C5E8;z-index:9999;transition:width 0.25s ease, opacity 0.3s ease;opacity:0;pointer-events:none;"></div>

  <!-- ZeroBug Kinetic Downward Plunge Transition ("Transisi Menghujam") -->
  <div id="page-plunge" class="page-plunge" aria-hidden="true" transition:persist="page-plunge">
    <div class="page-plunge__layer page-plunge__layer--accent"></div>
    <div class="page-plunge__layer page-plunge__layer--base">
      <div class="page-plunge__blade"></div>
      <div class="page-plunge__content">
        <div class="page-plunge__spear" aria-hidden="true">
          <svg class="page-plunge__spear-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="19"></line>
            <polyline points="5 12 12 19 19 12"></polyline>
          </svg>
        </div>
        <div class="page-plunge__badge">
          <div class="page-plunge__emblem">
            <img src="/logotrans.png" alt="ZeroBug Team Logo" class="page-plunge__logo-img" />
          </div>
          <div class="page-plunge__brand">
            <span class="page-plunge__title">Zero<span>Bug</span></span>
          </div>
        </div>
        <div class="page-plunge__thrust-lines" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Atlas Motion Minimalist Floating Scrollbar Indicator -->
  <div id="atlas-scroll-indicator" class="atlas-scroll-indicator" aria-hidden="true" transition:persist="scroll-indicator">
    <div id="atlas-scroll-bar" class="atlas-scroll-bar"></div>
  </div>

  <!-- SVG Sprite Definitions: Official Lucide Icons (Shadcn UI Standard) -->
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
    <defs>
      <!-- Lucide: Menu -->
      <symbol id="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
      </symbol>
      
      <!-- Lucide: X -->
      <symbol id="icon-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </symbol>
      
      <!-- Lucide: Sun -->
      <symbol id="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
      </symbol>
      
      <!-- Lucide: Moon (Theme toggle) -->
      <symbol id="icon-theme" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </symbol>
      
      <!-- Lucide: Code2 -->
      <symbol id="icon-code" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>
      </symbol>
      
      <!-- Lucide: Smartphone -->
      <symbol id="icon-smartphone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>
      </symbol>
      
      <!-- Lucide: Cpu -->
      <symbol id="icon-cpu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>
      </symbol>
      
      <!-- Lucide: Check -->
      <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"/>
      </symbol>
      
      <!-- Lucide: ArrowRight -->
      <symbol id="icon-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </symbol>
      
      <!-- Lucide: Sparkles -->
      <symbol id="icon-sparkles" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </symbol>
      
      <!-- Lucide: Layers -->
      <symbol id="icon-layers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
      </symbol>

      <!-- Lucide: Mail -->
      <symbol id="icon-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L1 7"/>
      </symbol>

      <!-- Lucide: Send -->
      <symbol id="icon-send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
      </symbol>

      <!-- Lucide: Copy -->
      <symbol id="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </symbol>

      <!-- Lucide: Clock -->
      <symbol id="icon-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </symbol>

      <!-- Lucide: ShieldCheck -->
      <symbol id="icon-shield-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
      </symbol>

      <!-- Lucide: Github -->
      <symbol id="icon-github" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>
      </symbol>
    </defs>
  </svg>

  <slot />

  <script is:inline>
    // Efek Transisi Menghujam (Kinetic Downward Plunge Transition)
    var isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var bar = document.getElementById('page-progress-bar');
    var plungeResetTimer = null;

    document.addEventListener('astro:before-preparation', function (event) {
      if (bar) {
        bar.style.opacity = '1';
        bar.style.width = '70%';
      }

      if (isReducedMotion) return;
      var plunge = document.getElementById('page-plunge');
      if (!plunge) return;

      if (plungeResetTimer) {
        clearTimeout(plungeResetTimer);
        plungeResetTimer = null;
      }

      plunge.classList.remove('is-diving-out', 'is-reset');
      plunge.classList.add('is-active', 'is-diving-in');

      var originalLoader = event.loader;
      event.loader = async function () {
        // Jalankan fetch halaman PARALEL dengan animasi sigap (tanpa blocking delay!)
        await Promise.all([
          originalLoader(),
          new Promise(function (resolve) { setTimeout(resolve, 200); })
        ]);
      };
    });

    document.addEventListener('astro:after-swap', function () {
      var plunge = document.getElementById('page-plunge');
      if (plunge && plunge.classList.contains('is-diving-in')) {
        requestAnimationFrame(function () {
          // Fase 2: Meneruskan hujaman keluar layar ke arah bawah secara sigap
          plunge.classList.remove('is-diving-in');
          plunge.classList.add('is-diving-out');

          plungeResetTimer = setTimeout(function () {
            // Reset posisi kembali ke atas (-100%) secara instan tanpa animasi
            plunge.classList.add('is-reset');
            plunge.classList.remove('is-diving-out', 'is-active');
            setTimeout(function () {
              plunge.classList.remove('is-reset');
            }, 30);
          }, 240);
        });
      }
    });

    function initInteractiveUI() {
      if (bar) {
        bar.style.width = '100%';
        setTimeout(function () {
          bar.style.opacity = '0';
          bar.style.width = '0%';
        }, 200);
      }

      var root = document.documentElement;

      // Theme toggle handler
      var themeToggle = document.getElementById('theme-toggle');
      function setTheme(mode) {
        root.setAttribute('data-theme', mode);
        try { localStorage.setItem('zerobug_theme', mode); } catch (e) {}
      }

      var savedTheme = null;
      try { savedTheme = localStorage.getItem('zerobug_theme'); } catch (e) {}
      if (savedTheme) {
        setTheme(savedTheme);
      } else {
        setTheme('light');
      }

      if (themeToggle) {
        var newToggle = themeToggle.cloneNode(true);
        themeToggle.parentNode.replaceChild(newToggle, themeToggle);
        newToggle.addEventListener('click', function () {
          var current = root.getAttribute('data-theme') || 'light';
          setTheme(current === 'dark' ? 'light' : 'dark');
        });
      }

      // Mobile Nav Drawer (Smooth 0.5s Easing & Backdrop)
      var navToggle = document.getElementById('nav-toggle');
      var mainNav = document.getElementById('main-nav');
      var navBackdrop = document.getElementById('nav-backdrop');

      function closeNav() {
        if (!mainNav || !navToggle) return;
        mainNav.classList.remove('is-open');
        navToggle.classList.remove('is-active');
        navToggle.setAttribute('aria-expanded', 'false');
        if (navBackdrop) navBackdrop.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      if (navToggle && mainNav) {
        var newNavToggle = navToggle.cloneNode(true);
        navToggle.parentNode.replaceChild(newNavToggle, navToggle);
        newNavToggle.addEventListener('click', function () {
          var isOpen = mainNav.classList.toggle('is-open');
          newNavToggle.classList.toggle('is-active', isOpen);
          newNavToggle.setAttribute('aria-expanded', String(isOpen));
          if (navBackdrop) navBackdrop.classList.toggle('is-open', isOpen);
          document.body.style.overflow = isOpen ? 'hidden' : '';
        });

        if (navBackdrop) {
          navBackdrop.addEventListener('click', closeNav);
        }

        mainNav.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            // Berikan waktu sejenak agar penutupan terasa smooth sebelum navigasi jika dalam halaman yang sama
            setTimeout(closeNav, 150);
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeNav();
        });
      }

      // Scroll Reveal (Atlas Motion Stagger & Curve)
      var revealEls = document.querySelectorAll('.reveal, .reveal-scale, .reveal-line');
      if ('IntersectionObserver' in window && revealEls.length) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.01, rootMargin: '0px 0px 80px 0px' }
        );
        revealEls.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    // Jalankan saat load pertama & setiap transisi halaman Astro selesai
    document.addEventListener('astro:page-load', initInteractiveUI);
  </script>

  <!-- Modul Physics-based Momentum Smooth Scroll Engine (Ala Atlas Motion) -->
  <script>
    import { initAtlasScroll, pauseAtlasScroll, resumeAtlasScroll, resetAtlasScrollTop } from '../scripts/atlas-scroll.js';

    document.addEventListener('astro:page-load', () => {
      initAtlasScroll();
    });

    document.addEventListener('astro:before-preparation', () => {
      pauseAtlasScroll();
    });

    document.addEventListener('astro:after-swap', () => {
      resetAtlasScrollTop();
      resumeAtlasScroll();
    });
  </script>
</body>
</html>
